# Ключи сервисов. Скопируйте этот файл в .env и впишите свои значения.
# Пустая строка или отсутствие ключа = сервис просто не используется,
# система продолжает работать с готовыми файлами озвучки.

# Генерация голоса. Ключ берётся в личном кабинете ElevenLabs.
ELEVENLABS_API_KEY=

# ИИ-аватар. Ключ того сервиса, который вы выбрали при настройке.
AVATAR_API_KEY=
